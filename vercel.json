{
  "version": 2,
  "routes": [
    {
      "src": "/out/(?<slug>[^/]+)",
      "dest": "/api/out?slug=$slug"
    },
    {
      "src": "/go/(?<slug>[^/]+)",
      "dest": "/api/out?slug=$slug"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/generator",
      "dest": "/admin.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
